{
  "openapi": "3.1.0",
  "info": { "title": "Big Apple Live Social", "version": "1.0.0" },
  "paths": {
    "/social/me": {
      "get": {
        "operationId": "getSocialMe",
        "tags": ["social"],
        "security": [{ "AccountSession": [] }],
        "responses": {
          "200": { "description": "Current profile and country options", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/SocialMe" } } } },
          "401": { "$ref": "./openapi.yaml#/components/responses/SessionUnauthorized" }
        }
      },
      "put": {
        "operationId": "saveSocialProfile",
        "tags": ["social"],
        "security": [{ "AccountSession": [] }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/SocialProfileInput" } } } },
        "responses": {
          "200": { "description": "Saved Race and Job choices", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/SocialPerson" } } } },
          "400": { "$ref": "./openapi.yaml#/components/responses/InvalidInput" },
          "401": { "$ref": "./openapi.yaml#/components/responses/SessionUnauthorized" }
        }
      }
    },
    "/social/cosmetics/store": {
      "get": {
        "operationId": "getProfileCosmeticsStore",
        "tags": ["social"],
        "security": [{ "AccountSession": [] }],
        "responses": {
          "200": { "description": "Owned profile cosmetics and available previews", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ProfileCosmeticsStore" } } } },
          "401": { "$ref": "./openapi.yaml#/components/responses/SessionUnauthorized" }
        }
      }
    },
    "/social/cosmetics/equip": {
      "put": {
        "operationId": "equipProfileCosmetic",
        "tags": ["social"],
        "security": [{ "AccountSession": [] }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ProfileCosmeticEquipInput" } } } },
        "responses": {
          "200": { "description": "Equipped an owned profile cosmetic", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ProfileCosmeticsStore" } } } },
          "400": { "$ref": "./openapi.yaml#/components/responses/InvalidInput" },
          "401": { "$ref": "./openapi.yaml#/components/responses/SessionUnauthorized" },
          "403": { "description": "The item is not owned" }
        }
      }
    },
    "/social/people": {
      "get": {
        "operationId": "getSocialPeople",
        "tags": ["social"],
        "security": [{ "AccountSession": [] }],
        "parameters": [
          { "name": "search", "in": "query", "schema": { "type": "string", "maxLength": 80 } },
          { "name": "gender", "in": "query", "schema": { "type": "string", "enum": ["Male", "Female"] } },
          { "name": "country", "in": "query", "schema": { "type": "string", "maxLength": 2 } },
          { "name": "favorites", "in": "query", "schema": { "type": "boolean" } },
          { "name": "offset", "in": "query", "schema": { "type": "integer", "minimum": 0 } }
        ],
        "responses": {
          "200": { "description": "Public profiles matching the query", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/SocialPeople" } } } },
          "401": { "$ref": "./openapi.yaml#/components/responses/SessionUnauthorized" }
        }
      }
    },
    "/social/people/{username}": {
      "get": {
        "operationId": "getSocialPerson",
        "tags": ["social"],
        "security": [{ "AccountSession": [] }],
        "parameters": [{ "name": "username", "in": "path", "required": true, "schema": { "type": "string" } }],
        "responses": {
          "200": { "description": "Public profile", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/SocialPerson" } } } },
          "401": { "$ref": "./openapi.yaml#/components/responses/SessionUnauthorized" },
          "404": { "description": "Profile unavailable" }
        }
      }
    },
    "/social/people/{username}/relationship": {
      "put": {
        "operationId": "setSocialRelationship",
        "tags": ["social"],
        "security": [{ "AccountSession": [] }],
        "parameters": [{ "name": "username", "in": "path", "required": true, "schema": { "type": "string" } }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/SocialRelationshipInput" } } } },
        "responses": {
          "200": { "description": "Updated follow or block relationship", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/SocialAction" } } } },
          "400": { "$ref": "./openapi.yaml#/components/responses/InvalidInput" },
          "401": { "$ref": "./openapi.yaml#/components/responses/SessionUnauthorized" }
        }
      }
    },
    "/social/blocks": {
      "get": {
        "operationId": "getSocialBlocks",
        "tags": ["social"],
        "security": [{ "AccountSession": [] }],
        "responses": {
          "200": { "description": "Blocked profiles", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/SocialPeople" } } } },
          "401": { "$ref": "./openapi.yaml#/components/responses/SessionUnauthorized" }
        }
      }
    },
    "/social/messages": {
      "get": {
        "operationId": "getSocialInbox",
        "tags": ["social"],
        "security": [{ "AccountSession": [] }],
        "responses": {
          "200": { "description": "Private-message inbox", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/SocialInbox" } } } },
          "401": { "$ref": "./openapi.yaml#/components/responses/SessionUnauthorized" }
        }
      }
    },
    "/social/messages/{username}": {
      "get": {
        "operationId": "getSocialConversation",
        "tags": ["social"],
        "security": [{ "AccountSession": [] }],
        "parameters": [
          { "name": "username", "in": "path", "required": true, "schema": { "type": "string" } },
          { "name": "cursor", "in": "query", "schema": { "type": "string", "format": "uuid" } }
        ],
        "responses": {
          "200": { "description": "Private conversation", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/SocialConversation" } } } },
          "401": { "$ref": "./openapi.yaml#/components/responses/SessionUnauthorized" }
        }
      },
      "post": {
        "operationId": "sendSocialMessage",
        "tags": ["social"],
        "security": [{ "AccountSession": [] }],
        "parameters": [{ "name": "username", "in": "path", "required": true, "schema": { "type": "string" } }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/SocialMessageInput" } } } },
        "responses": {
          "200": { "description": "Message sent", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/SocialMessage" } } } },
          "401": { "$ref": "./openapi.yaml#/components/responses/SessionUnauthorized" }
        }
      },
      "delete": {
        "operationId": "deleteSocialConversation",
        "tags": ["social"],
        "security": [{ "AccountSession": [] }],
        "parameters": [{ "name": "username", "in": "path", "required": true, "schema": { "type": "string" } }],
        "responses": {
          "200": { "description": "Conversation hidden for the current user", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/SocialAction" } } } },
          "401": { "$ref": "./openapi.yaml#/components/responses/SessionUnauthorized" }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "SocialPerson": {
        "type": "object",
        "properties": {
          "username": { "type": "string" },
          "displayName": { "type": "string" },
          "photoUrl": { "type": ["string", "null"] },
          "photoUrls": { "type": "array", "maxItems": 1, "items": { "type": "string" } },
          "photoReviews": { "type": "array", "items": { "$ref": "./openapi.yaml#/components/schemas/PhotoReviewStatus" } },
          "identity": { "$ref": "./openapi.yaml#/components/schemas/EmojiIdentity" },
          "race": { "type": "string", "enum": ["Human"] },
          "job": { "type": ["string", "null"], "enum": ["Apprentice", "Squire", "Initiate", "Trapper", "Novice", "Acolyte", "Scoundrel", "Tinker", null] },
          "favorite": { "type": "boolean" },
          "blocked": { "type": "boolean" },
          "frameId": { "type": "string" },
          "displayNameColor": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
          "displayNameTierIndex": { "type": "integer", "minimum": 0, "maximum": 1 },
          "hasNameShimmer": { "type": "boolean" },
          "followerCount": { "type": "integer", "minimum": 0 },
          "followingCount": { "type": "integer", "minimum": 0 }
        },
        "required": ["username", "displayName", "photoUrl", "photoUrls", "identity", "race", "job", "favorite", "blocked", "frameId", "displayNameColor", "displayNameTierIndex", "hasNameShimmer"]
      },
      "SocialProfileInput": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "race": { "type": "string", "enum": ["Human"] },
          "job": { "type": ["string", "null"], "enum": ["Apprentice", "Squire", "Initiate", "Trapper", "Novice", "Acolyte", "Scoundrel", "Tinker", null] }
        },
        "minProperties": 1
      },
      "SocialMe": {
        "type": "object",
        "properties": {
          "profile": { "$ref": "#/components/schemas/SocialPerson" },
          "countries": { "type": "array", "items": { "type": "object", "properties": { "code": { "type": "string" }, "name": { "type": "string" } }, "required": ["code", "name"] } }
        },
        "required": ["profile", "countries"]
      },
      "SocialPeople": {
        "type": "object",
        "properties": {
          "people": { "type": "array", "items": { "$ref": "#/components/schemas/SocialPerson" } },
          "total": { "type": "integer", "minimum": 0 }
        },
        "required": ["people", "total"]
      },
      "SocialRelationshipInput": {
        "type": "object",
        "additionalProperties": false,
        "properties": { "kind": { "type": "string", "enum": ["favorite", "block"] }, "active": { "type": "boolean" } },
        "required": ["kind", "active"]
      },
      "SocialAction": { "type": "object", "properties": { "ok": { "type": "boolean" } }, "required": ["ok"] },
      "ProfileCosmeticItem": {
        "type": "object",
        "properties": {
          "id": { "type": "string" }, "name": { "type": "string" },
          "priceCents": { "type": "integer", "minimum": 0 }, "available": { "type": "boolean" },
          "owned": { "type": "boolean" }, "equipped": { "type": "boolean" },
          "image": { "type": "string" }, "tint": { "type": "string" }, "color": { "type": "string" }
        },
        "required": ["id", "name", "priceCents", "available", "owned", "equipped"]
      },
      "ProfileCosmeticsStore": {
        "type": "object",
        "properties": {
          "sections": { "type": "array", "items": { "type": "object", "properties": { "kind": { "type": "string", "enum": ["frame", "nameColor", "specialName"] }, "title": { "type": "string" }, "items": { "type": "array", "items": { "$ref": "#/components/schemas/ProfileCosmeticItem" } } }, "required": ["kind", "title", "items"] } },
          "equipped": { "type": "object", "properties": { "frame": { "type": "string" }, "nameColor": { "type": "string" }, "specialName": { "type": ["string", "null"] } }, "required": ["frame", "nameColor", "specialName"] }
        },
        "required": ["sections", "equipped"]
      },
      "ProfileCosmeticEquipInput": {
        "type": "object",
        "additionalProperties": false,
        "properties": { "kind": { "type": "string", "enum": ["frame", "nameColor", "specialName"] }, "itemId": { "type": "string", "minLength": 1, "maxLength": 40 } },
        "required": ["kind", "itemId"]
      },
      "SocialMessage": {
        "type": "object",
        "properties": {
          "id": { "type": "string" }, "sender": { "type": "string" }, "recipient": { "type": "string" },
          "body": { "type": "string" }, "createdAt": { "type": "string", "format": "date-time" },
          "readAt": { "type": ["string", "null"], "format": "date-time" }
        },
        "required": ["id", "sender", "recipient", "body", "createdAt", "readAt"]
      },
      "SocialMessageInput": {
        "type": "object", "additionalProperties": false,
        "properties": { "body": { "type": "string", "minLength": 1, "maxLength": 1000 }, "idempotencyKey": { "type": "string", "format": "uuid" } },
        "required": ["body", "idempotencyKey"]
      },
      "SocialConversation": {
        "type": "object",
        "properties": {
          "person": { "$ref": "#/components/schemas/SocialPerson" },
          "messages": { "type": "array", "items": { "$ref": "#/components/schemas/SocialMessage" } },
          "nextCursor": { "type": ["string", "null"] }, "blocked": { "type": "boolean" }
        },
        "required": ["person", "messages", "nextCursor", "blocked"]
      },
      "SocialInbox": {
        "type": "object",
        "properties": {
          "conversations": { "type": "array", "items": { "type": "object", "properties": {
            "username": { "type": "string" }, "displayName": { "type": "string" },
            "displayNameColor": { "type": "string" }, "displayNameTierIndex": { "type": "integer" },
            "photoUrl": { "type": ["string", "null"] }, "identity": { "$ref": "./openapi.yaml#/components/schemas/EmojiIdentity" },
            "lastMessageFromMe": { "type": "boolean" }, "lastUnreadAt": { "type": ["string", "null"], "format": "date-time" },
            "lastMessage": { "type": "string" }, "updatedAt": { "type": "string", "format": "date-time" },
            "unreadCount": { "type": "integer", "minimum": 0 }, "blocked": { "type": "boolean" }
          }, "required": ["username", "displayName", "displayNameColor", "displayNameTierIndex", "photoUrl", "identity", "lastMessageFromMe", "lastUnreadAt", "lastMessage", "updatedAt", "unreadCount", "blocked"] } }
        },
        "required": ["conversations"]
      }
    }
  }
}
