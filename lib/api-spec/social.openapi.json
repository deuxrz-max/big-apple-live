  "components": {
    "schemas": {
      "SocialPerson": {
        "type": "object",
        "properties": {
          "externalPlatform": { "type": ["string", "null"], "enum": ["LiveMe", "Bigo Live", "Tango Live", "TikTok", "Instagram Live", "Super Live", null] },
          "externalHandle": { "type": ["string", "null"], "maxLength": 64 },
          "username": {
            "type": "string"
          },
          "displayName": { "type": "string" },
          "followerCount": { "type": "integer", "minimum": 0 },
          "followingCount": { "type": "integer", "minimum": 0 },
          "sentCredits": { "type": "integer", "minimum": 0 },
          "badges": { "type": "array", "items": { "type": "object", "required": ["id", "earnedAt"], "properties": { "id": { "type": "string" }, "earnedAt": { "type": "string", "format": "date-time" } } } },
          "photoUrl": { "type": ["string", "null"] },
          "photoUrls": { "type": "array", "maxItems": 4, "items": { "type": "string" } },
          "photoReviews": { "type": "array", "items": { "$ref": "./openapi.yaml#/components/schemas/PhotoReviewStatus" } },
          "identity": {
            "$ref": "./openapi.yaml#/components/schemas/EmojiIdentity"
          },
          "bio": {
            "type": "string"
          },
          "country": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "interests": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "discoverable": {
            "type": "boolean"
          },
          "favorite": {
            "type": "boolean"
          },
          "blocked": {
            "type": "boolean"
          },
          "receivedCredits": {
            "type": "integer"
          },
          "badgeId": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "username",
          "identity",
          "bio",
          "country",
          "interests",
          "discoverable",
          "favorite",
          "blocked",
          "receivedCredits",
          "badgeId"
        ]
      },
      "SocialProfileInput": {
        "type": "object",
        "properties": {
          "externalPlatform": { "type": ["string", "null"], "enum": ["LiveMe", "Bigo Live", "Tango Live", "TikTok", "Instagram Live", "Super Live", null] },
          "externalHandle": { "type": ["string", "null"], "maxLength": 64 },
          "bio": {
            "type": "string",
            "maxLength": 200
          },
          "country": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[A-Z]{2}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "interests": {
            "type": "array",
            "maxItems": 8,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 24
            }
          },
          "discoverable": {
            "type": "boolean"
          },
          "badgeId": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "bio",
          "country",
          "interests",
          "discoverable",
          "badgeId"
        ]
      },
      "SocialWallet": {
        "type": "object",
        "properties": {
          "balance": {
            "type": "integer"
          },
          "earned": {
            "type": "integer"
          },
          "received": {
            "type": "integer"
          },
          "sent": {
            "type": "integer"
          },
          "canClaimDaily": {
            "type": "boolean"
          },
          "dailyReward": {
            "type": "integer"
          }
        },
        "required": [
          "balance",
          "earned",
          "received",
          "sent",
          "canClaimDaily",
          "dailyReward"
        ]
      },
      "SocialProduct": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "cost": {
            "type": "integer"
          }
        },
        "required": [
          "id",
          "name",
          "description",
          "cost"
        ]
      },
      "SocialGift": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "cost": {
            "type": "integer"
          }
        },
        "required": [
          "id",
          "name",
          "cost"
        ]
      },
      "SocialMe": {
        "type": "object",
        "properties": {
          "badgeExpirations": {
            "type": "object",
            "additionalProperties": { "type": "string", "format": "date-time" }
          },
          "loginStreak": { "type": "integer", "minimum": 0 },
          "profile": {
            "$ref": "#/components/schemas/SocialPerson"
          },
          "wallet": {
            "$ref": "#/components/schemas/SocialWallet"
          },
          "inventory": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "products": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SocialProduct"
            }
          },
          "gifts": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SocialGift"
            }
          },
          "giftQuantities": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 1}},
          "countries": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "code": {
                  "type": "string"
                },
                "name": {
                  "type": "string"
                }
              },
              "required": [
                "code",
                "name"
              ]
            }
          }
        },
        "required": [
          "profile",
          "wallet",
          "inventory",
          "products",
          "gifts",
          "countries"
        ]
      },
      "SocialPeople": {
        "type": "object",
        "properties": {
          "people": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SocialPerson"
            }
          },
          "total": {
            "type": "integer"
          }
        },
        "required": [
          "people",
          "total"
        ]
      },
      "SocialRelationshipInput": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "favorite",
              "block"
            ]
          },
          "active": {
            "type": "boolean"
          }
        },
        "required": [
          "kind",
          "active"
        ]
      },
      "SocialAction": {
        "type": "object",
        "properties": {
          "ok": {
            "type": "boolean"
          }
        },
        "required": [
          "ok"
        ]
      },
      "RoomGiftEvent": {
        "type": "object",
        "properties": {
          "id": {"type": "string"},
          "giftId": {"type": "string"},
          "senderUsername": {"type": "string"},
          "recipientUsername": {"type": "string"},
          "senderName": {"type": "string"},
          "recipientName": {"type": "string"},
          "createdAt": {"type": "string", "format": "date-time"}
        },
