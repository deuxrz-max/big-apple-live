{
  "name": "@workspace/we-buggin",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "pnpm run brand:icons",
    "dev": "vite --config vite.config.ts --host 0.0.0.0",
    "prebuild": "pnpm run brand:icons",
    "build": "vite build --config vite.config.ts",
    "serve": "vite preview --config vite.config.ts --host 0.0.0.0",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "brand:icons": "bash scripts/generate-brand-icons.sh",
    "test:room-audio-policy": "esbuild tests/roomAudioPolicy.test.ts --bundle --platform=node --format=esm --outfile=/tmp/we-buggin-room-audio-policy-tests.mjs && node --test /tmp/we-buggin-room-audio-policy-tests.mjs",
    "test:audio-seat-layout": "esbuild tests/audioSeatLayout.test.ts --bundle --platform=node --format=esm --outfile=/tmp/we-buggin-audio-seat-layout-tests.mjs && node --test /tmp/we-buggin-audio-seat-layout-tests.mjs",
    "test:promo-browser": "tsc -p tests/browser/tsconfig.json --noEmit && node tests/browser/run.mjs",
    "test:audio-harness-browser": "pnpm exec playwright test --config tests/browser/audio-harness.live.config.ts",
    "test:live": "node --test tests/liveBeam.test.mjs",
    "test:mobile-shell": "esbuild tests/mobileShell.test.ts --bundle --platform=node --format=esm --outfile=/tmp/we-buggin-mobile-shell-tests.mjs && node --test /tmp/we-buggin-mobile-shell-tests.mjs",
    "test:battle": "esbuild tests/battleEngine.test.ts --bundle --platform=node --format=esm --outfile=/tmp/we-buggin-battle-tests.mjs && node --test /tmp/we-buggin-battle-tests.mjs",
    "test:gifting-levels": "esbuild tests/giftingLevels.test.ts --bundle --platform=node --format=esm --outfile=/tmp/we-buggin-gifting-levels-tests.mjs && node --test /tmp/we-buggin-gifting-levels-tests.mjs",
    "test:passport-removal": "esbuild tests/passportRemoval.test.ts --bundle --platform=node --format=esm --jsx=automatic --outfile=/tmp/we-buggin-passport-removal-tests.mjs && node --test /tmp/we-buggin-passport-removal-tests.mjs",
    "test:pink-card": "esbuild tests/pinkCard.test.ts --bundle --platform=node --format=esm --outfile=/tmp/we-buggin-pink-card-tests.mjs && node --test /tmp/we-buggin-pink-card-tests.mjs"
  },
  "devDependencies": {
    "@hookform/resolvers": "^3.10.0",
    "@playwright/test": "1.63.0",
    "@radix-ui/react-accordion": "^1.2.4",
    "@radix-ui/react-alert-dialog": "^1.1.7",
    "@radix-ui/react-aspect-ratio": "^1.1.3",
    "@radix-ui/react-avatar": "^1.1.4",
    "@radix-ui/react-checkbox": "^1.1.5",
    "@radix-ui/react-collapsible": "^1.1.4",
    "@radix-ui/react-context-menu": "^2.2.7",
    "@radix-ui/react-dialog": "^1.1.7",
    "@radix-ui/react-dropdown-menu": "^2.1.7",
    "@radix-ui/react-hover-card": "^1.1.7",
    "@radix-ui/react-label": "^2.1.3",
    "@radix-ui/react-menubar": "^1.1.7",
    "@radix-ui/react-navigation-menu": "^1.2.6",
    "@radix-ui/react-popover": "^1.1.7",
    "@radix-ui/react-progress": "^1.1.3",
    "@radix-ui/react-radio-group": "^1.2.4",
    "@radix-ui/react-scroll-area": "^1.2.4",
    "@radix-ui/react-select": "^2.1.7",
    "@radix-ui/react-separator": "^1.1.3",
    "@radix-ui/react-slider": "^1.2.4",
    "@radix-ui/react-slot": "^1.2.0",
    "@radix-ui/react-switch": "^1.1.4",
    "@radix-ui/react-tabs": "^1.1.4",
    "@radix-ui/react-toast": "^1.2.7",
    "@radix-ui/react-toggle": "^1.1.3",
    "@radix-ui/react-toggle-group": "^1.1.3",
    "@radix-ui/react-tooltip": "^1.2.0",
    "@replit/vite-plugin-cartographer": "catalog:",
    "@replit/vite-plugin-dev-banner": "catalog:",
    "@replit/vite-plugin-runtime-error-modal": "catalog:",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "catalog:",
    "@tanstack/react-query": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "@workspace/api-client-react": "workspace:*",
    "class-variance-authority": "catalog:",
    "clsx": "catalog:",
    "cmdk": "^1.1.1",
    "date-fns": "^3.6.0",
    "embla-carousel-react": "^8.6.0",
    "esbuild": "0.28.2",
    "framer-motion": "catalog:",
    "input-otp": "^1.4.2",
    "lucide-react": "catalog:",
    "next-themes": "^0.4.6",
    "phaser": "^3.90.0",
    "react": "19.1.4",
    "react-day-picker": "^9.11.1",
    "react-dom": "19.1.4",
    "react-hook-form": "^7.55.0",
    "react-icons": "^5.4.0",
    "react-resizable-panels": "^2.1.7",
    "recharts": "^2.15.2",
    "sonner": "^2.0.7",
    "tailwind-merge": "catalog:",
    "tailwindcss": "catalog:",
    "tw-animate-css": "^1.4.0",
    "vaul": "^1.1.2",
    "vite": "catalog:",
    "wouter": "^3.3.5",
    "zod": "catalog:"
  },
  "dependencies": {
    "@clerk/react": "^6.17.4",
    "@clerk/themes": "^2.4.57",
    "@workspace/beam-identity": "workspace:*",
    "@workspace/room-audio": "workspace:*",
    "livekit-client": "^2.22.4",
    "lottie-web": "^5.13.0",
    "socket.io-client": "^4.8.4"
  }
}
