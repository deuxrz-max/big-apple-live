{
  "name": "@workspace/we-buggin",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "pnpm run brand:icons",
    "dev": "vite --config vite.config.ts --host 0.0.0.0",
    "prebuild": "pnpm run brand:icons",
    "build": "vite build --config vite.config.ts",
    "serve": "vite preview --config vite.config.ts --host 0.0.0.0",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "brand:icons": "bash scripts/generate-brand-icons.sh",
    "test:chess": "esbuild tests/chessRoom.test.ts --bundle --platform=node --format=esm --outfile=/tmp/we-buggin-chess-tests.mjs && node --test /tmp/we-buggin-chess-tests.mjs",
    "test:beams": "esbuild tests/beamService.test.ts --bundle --platform=node --format=esm --outfile=/tmp/we-buggin-beam-tests.mjs && node --test /tmp/we-buggin-beam-tests.mjs",
    "test:video-beam-grid": "esbuild tests/videoBeamGrid.test.ts --bundle --platform=node --format=esm --outfile=/tmp/we-buggin-video-beam-grid-tests.mjs && node --test /tmp/we-buggin-video-beam-grid-tests.mjs",
    "test:go-live-choice": "esbuild tests/goLiveChoice.test.ts --bundle --platform=node --format=esm --outfile=/tmp/we-buggin-go-live-choice-tests.mjs && node --test /tmp/we-buggin-go-live-choice-tests.mjs",
    "test:owner-card-game-test-mode": "esbuild tests/ownerCardGameTestMode.test.ts --bundle --platform=node --format=esm --outfile=/tmp/we-buggin-owner-card-game-test-tests.mjs && node --test /tmp/we-buggin-owner-card-game-test-tests.mjs",
    "test:beam-audio-policy": "esbuild tests/beamAudioPolicy.test.ts --bundle --platform=node --format=esm --outfile=/tmp/we-buggin-beam-audio-policy-tests.mjs && node --test /tmp/we-buggin-beam-audio-policy-tests.mjs",
    "test:live-chat-block-policy": "esbuild tests/liveChatBlockPolicy.test.ts --bundle --platform=node --format=esm --outfile=/tmp/we-buggin-live-chat-block-tests.mjs && node --test /tmp/we-buggin-live-chat-block-tests.mjs",
    "test:playlist": "esbuild tests/promoPlaylist.test.ts --bundle --platform=node --format=esm --outfile=/tmp/streamtalk-promo-tests.mjs && node --test /tmp/streamtalk-promo-tests.mjs",
    "test:badges": "esbuild tests/badgeCatalog.test.ts --bundle --platform=node --format=esm --outfile=/tmp/we-buggin-badge-tests.mjs && node --test /tmp/we-buggin-badge-tests.mjs",
    "test:gift-combo": "esbuild tests/giftCombo.test.ts --bundle --platform=node --format=esm --outfile=/tmp/we-buggin-gift-combo-tests.mjs && node --test /tmp/we-buggin-gift-combo-tests.mjs",
    "test:entrance-effects": "esbuild tests/entranceEffectAssets.test.ts --bundle --platform=node --format=esm --outfile=/tmp/we-buggin-entrance-effect-tests.mjs && node --test /tmp/we-buggin-entrance-effect-tests.mjs",
    "test:promo-browser": "tsc -p tests/browser/tsconfig.json --noEmit && node tests/browser/run.mjs",
    "test:audio-harness-browser": "pnpm exec playwright test --config tests/browser/audio-harness.live.config.ts",
    "test:live": "node --test tests/liveBeam.test.mjs",
    "test:card-surface-finish": "esbuild tests/cardSurfaceFinish.test.ts --bundle --platform=node --format=esm --outfile=/tmp/we-buggin-card-finish-tests.mjs && node --test /tmp/we-buggin-card-finish-tests.mjs",
    "test:mobile-shell": "esbuild tests/mobileShell.test.ts --bundle --platform=node --format=esm --outfile=/tmp/we-buggin-mobile-shell-tests.mjs && node --test /tmp/we-buggin-mobile-shell-tests.mjs",
    "test:joker-webgl": "esbuild tests/jokerWebgl.test.ts --bundle --platform=node --format=esm --outfile=/tmp/we-buggin-joker-webgl-tests.mjs && node --test /tmp/we-buggin-joker-webgl-tests.mjs",
    "test:joker-finish": "esbuild tests/jokerFinish.test.ts --bundle --platform=node --format=esm --outfile=/tmp/we-buggin-joker-finish-tests.mjs && node --test /tmp/we-buggin-joker-finish-tests.mjs",
    "test:gifting-levels": "esbuild tests/giftingLevels.test.ts --bundle --platform=node --format=esm --outfile=/tmp/we-buggin-gifting-levels-tests.mjs && node --test /tmp/we-buggin-gifting-levels-tests.mjs",
    "test:passport-removal": "esbuild tests/passportRemoval.test.ts --bundle --platform=node --format=esm --jsx=automatic --outfile=/tmp/we-buggin-passport-removal-tests.mjs && node --test /tmp/we-buggin-passport-removal-tests.mjs",
    "test:pink-card": "esbuild tests/pinkCard.test.ts --bundle --platform=node --format=esm --outfile=/tmp/we-buggin-pink-card-tests.mjs && node --test /tmp/we-buggin-pink-card-tests.mjs"
  },
