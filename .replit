modules = ["nodejs-24", "python-base-3.13", "postgresql-16"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[nix]
channel = "stable-25_05"
packages = ["xorg.xorgserver"]

[userenv]

[userenv.development]
STREAMTALK_TEST_LOGINS = "[{\"displayName\":\"Test Bigo 1\",\"email\":\"streamtalk.test.bigo1+clerk_test@example.com\",\"username\":\"TestBigo1\"},{\"displayName\":\"Test Bigo 2\",\"email\":\"streamtalk.test.bigo2+clerk_test@example.com\",\"username\":\"TestBigo2\"},{\"displayName\":\"Test Bigo 3\",\"email\":\"streamtalk.test.bigo3+clerk_test@example.com\",\"username\":\"TestBigo3\"},{\"displayName\":\"Test Bigo 4\",\"email\":\"streamtalk.test.bigo4+clerk_test@example.com\",\"username\":\"TestBigo4\"}]"
