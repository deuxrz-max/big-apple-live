modules = ["nodejs-24", "python-base-3.13", "postgresql-16"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[nix]
channel = "stable-25_05"
packages = ["xorg.xorgserver", "jdk17", "patchelf"]

[userenv]

[userenv.development]
STREAMTALK_TEST_LOGINS = "Deuxrz@gmail.com"

[userenv.shared]

[userenv.production]
STREAMTALK_TEST_LOGINS = "Deuxrz@gmail.com"
